{
  // 掼蛋：静态资源 Worker + 一个很小的脚本（登录闸门、联机房间的开房进房），只经平台的域名访问（路径路由 <站点>/games/guandan*），不开 workers.dev。
  // 这里不写路由：部署时由工作流注入（wrangler deploy --route），站点的主机名只在部署环境的 secret 里，见 README 的部署一节。
  // 入口 worker/main.ts：默认导出（worker/index.ts）+ 房间类 Room（Durable Object）。
  // 产物由 tools/build-cf.ts 生成在 dist-cf/games/guandan/ 下（npm run build:cf），_headers/_redirects 在 dist-cf/ 根。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guandan",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 只有首页导航先进 Worker 做登录检查、房间接口（开房、进房）和单机实盘接口（带入、结回、放弃）进 Worker；js、图片等照旧直接走静态资源，不花 Worker 请求额度。
    // 实盘接口放在 /api/ 下面，才在网关的限速范围里（/games/* 下含 /api/）
    "run_worker_first": ["/games/guandan", "/games/guandan/", "/games/guandan/index.html", "/games/guandan/room/*", "/games/guandan/api/stake/*"]
  },
  // 联机房间：一个房间码一个 Durable Object（worker/room.ts）。免费版只能用 SQLite 后端。
  // METER 是 arcade-kit 的计量（全局一个）：每天的写入额度、按人和全站的开房名额。删了它就不限额（tests/config.test.ts 会挂）
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "METER", "class_name": "RoomMeter" }
    ]
  },
  // v1 已经上线，不能改；计量另加一条
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomMeter"] }
  ],
  // ARCADE：问平台登录状态（GET /api/me），登录闸门、进房认人、实盘认人都用。
  // WALLET：平台钱包的 RPC（docs/platform-backend.md 5.9）。props.game 必须是 guandan，平台按它只让掼蛋动掼蛋那一份；没写一律回 bad_game
  "services": [
    { "binding": "ARCADE", "service": "arcade" },
    { "binding": "WALLET", "service": "arcade", "entrypoint": "WalletService", "props": { "game": "guandan" } }
  ],
  "vars": {
    // "off"：不检查；"login"：没登录不让进（邀请制测试）。只有 "off" 放行，其他值都按 "login" 处理
    "GATE": "login",
    // "on"：开联机；其他值开房 404、进房 4004。出问题时改成 "off" 再走 PR 就能一键关掉
    "ONLINE": "on",
    // 每天的额度门槛（arcade-kit 的计量）。10 万行写入是全账户共用的：掼蛋 5 万停开新房、6 万收场，各游戏怎么分见仓库根 docs/platform-backend.md 4.7。
    // 每人开房（0.6.0 起放宽，不给玩家设没必要的限制）：同时 5 个、每天 100 个；全站每天 300 个照 kit 默认（防账单的不放宽）
    "KIT_QUOTA": { "busyWrites": 50000, "stopWrites": 60000, "roomsPerUser": 5, "dailyRoomsPerUser": 100 }
  }
}
