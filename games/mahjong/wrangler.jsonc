// mahjong Worker 正式配置（DESIGN.md 第 4、6 节）：页面 + 登录闸门 + 单机带入结回（转平台钱包）+ 好友房。
// 部署只走 .github/workflows/game-mahjong.yml（main 上经 PR 合并的提交）：先 npm run build:cf 把页面打到 dist-cf/games/mahjong/，再 wrangler deploy。
// 路由（<站点>/games/mahjong、<站点>/games/mahjong/*）和 SITE_ORIGIN 不写在这里，由部署时注入，见 README 的部署一节。
{
  "name": "mahjong",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 只有这些先过 Worker：首页（登录闸门）、单机带入结回、开房进房；其余静态资源直接回。/api/*（含 /api/wallet）由平台的路由接
    "run_worker_first": ["/games/mahjong", "/games/mahjong/", "/games/mahjong/index.html", "/games/mahjong/api/stake/*", "/games/mahjong/rooms", "/games/mahjong/rooms/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "MahjongRoom" },
      { "name": "METER", "class_name": "RoomMeter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MahjongRoom", "RoomMeter"] }],
  "services": [
    // 认人（/api/me）
    { "binding": "ARCADE", "service": "arcade" },
    // 平台钱包（docs/platform-backend.md 5.9）：平台按 props.game 认是哪个游戏
    { "binding": "WALLET", "service": "arcade", "entrypoint": "WalletService", "props": { "game": "mahjong" } }
  ],
  "vars": {
    "GATE": "login",
    // 每天的 DO 写入预算（DESIGN.md 第 9 节，一房约 800 行）：到 busy 不开新房，到 stop 收场。
    // 每人开房同时 5 个、每天 100 个（和德州一样不卡人）；全站上限照 kit 默认
    "KIT_QUOTA": { "busyWrites": 8000, "stopWrites": 10000, "roomsPerUser": 5, "dailyRoomsPerUser": 100 }
  }
}
