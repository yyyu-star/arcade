{
  "name": "yexun",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "license": "MIT",
  "description": "夜巡：道士夜巡雪夜古镇的幸存者类动作游戏，守夜和夜探两个模式；筹码无任何现金价值",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:cf": "npm run typecheck && vite build --outDir dist-cf/games/yexun --emptyOutDir",
    "preview": "vite preview",
    "deploy": "npm run build:cf && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "npm run typecheck && vitest run",
    "shot": "node tools/shot.ts",
    "smoke": "node tools/smoke.ts",
    "sim": "node tools/sim.ts",
    "bench": "node tools/bench.ts"
  },
  "dependencies": {
    "arcade-kit": "npm:@yyyu-star/arcade-kit@^0.15.1",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^22.0.0",
    "playwright-core": "1.58.0",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
