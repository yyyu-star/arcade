// texas Worker 正式配置（DESIGN.md 第 10 节）：页面 + 登录闸门 + 单机带入结回（转平台钱包）+ 好友房。
// 部署只走 .github/workflows/game-texas.yml（main 上经 PR 合并的提交）：先 npm run build:cf 把页面打到 dist-cf/games/texas/，再 wrangler deploy。
// 路由（<站点>/games/texas 和 <站点>/games/texas/*）和 SITE_ORIGIN 不写在这里，由部署时注入，见 README 的部署一节；workers_dev 关着，没有路由时外面访问不到。
{
  "name": "texas",
  "main": "worker/main.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // 只有这些先过 Worker：首页（登录闸门）、单机带入结回、开房进房；其余静态资源直接回。/api/*（含 /api/wallet）由平台的路由接
    "run_worker_first": ["/games/texas", "/games/texas/", "/games/texas/index.html", "/games/texas/api/solo/*", "/games/texas/rooms", "/games/texas/rooms/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "TexasRoom" },
      { "name": "METER", "class_name": "RoomMeter" }
    ]
  },
  // 德州之前没部署过，一个 v1 就够；钱包是平台的，没有 Wallet
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TexasRoom", "RoomMeter"] }],
  "services": [
    // 认人（/api/me）
    { "binding": "ARCADE", "service": "arcade" },
    // 平台钱包（docs/platform-backend.md 5.9）：平台按 props.game 认是哪个游戏
    { "binding": "WALLET", "service": "arcade", "entrypoint": "WalletService", "props": { "game": "texas" } }
  ],
  "vars": {
    "GATE": "login",
    // 德州每天的 DO 写入预算（DESIGN.md 第 7 节）：到 busy 不开新房，到 stop 收场。
    // 每人开房（0.2.4 维护者定：不让玩家感到限制）：同时 5 个、每天 100 个；全站上限照 kit 默认（防账单的不放宽）。
    // 嘲讽、表情、道具（0.3.0：玩家感觉不到，可以后台调）：每座位每秒补 1 个令牌、最多攒 3 个，客户端排队静默发
    "KIT_QUOTA": { "busyWrites": 15000, "stopWrites": 20000, "roomsPerUser": 5, "dailyRoomsPerUser": 100, "emoteMs": 1000, "emoteBurst": 3 }
  }
}
