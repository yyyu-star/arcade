{
  "name": "danli",
  "private": true,
  "license": "MIT",
  "version": "0.4.0",
  "type": "module",
  "description": "弹里个弹：回合制抛物线对战，萌宠和厨房道具大乱斗；地形能炸、有风，掉出画本出局；单机和好友房",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:cf": "npm run typecheck && vite build --outDir dist-cf/games/danli --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "npm run typecheck && vitest run && npm run cpu",
    "smoke": "node scripts/smoke.ts",
    "deploy": "npm run build:cf && wrangler deploy",
    "sim": "node scripts/sim.ts",
    "shots": "node scripts/shots.ts",
    "perf": "node scripts/perf.ts",
    "cpu": "node scripts/cpu.ts",
    "dev:worker": "npm run build:cf && wrangler dev --port 4179 --ip 0.0.0.0"
  },
  "dependencies": {
    "arcade-kit": "npm:@yyyu-star/arcade-kit@^0.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^22.0.0",
    "playwright-core": "1.58.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
